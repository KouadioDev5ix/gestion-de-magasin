{
  "expo": {
    "name": "GestCom",
    "slug": "gestCom",
    "scheme": "gestcom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gestcom.app"
    },
    "android": {
      "package": "com.gestcom.app",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GestCom a besoin d'accéder à vos photos pour illustrer vos articles.",
          "cameraPermission": "GestCom a besoin de l'appareil photo pour photographier vos articles."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
